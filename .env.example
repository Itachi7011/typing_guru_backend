# .env
# NODE_ENV=production
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173/
APP_NAME="TypingHub"

DEVELOPMENT_BASE_FRONTEND_URL=http://localhost:5173
DEVELOPMENT_BASE_BACKEND_URL=http://localhost:5000

PRODUCTION_BASE_FRONTEND_URL=https://shivam-webstack.netlify.app
PRODUCTION_BASE_BACKEND_URL=https://shivam-stack-backend.onrender.com


# MongoDB
MONGODB_URI=""

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin specific
ADMIN_URL=http://localhost:5173/admin
JWT_ADMIN_ACCESS_EXPIRE=4h
JWT_ADMIN_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME = 
CLOUDINARY_API_KEY = 
CLOUDINARY_API_SECRET = 


EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=120 # minutes

